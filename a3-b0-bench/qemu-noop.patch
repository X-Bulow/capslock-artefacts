+#define helper_store_with_cap helper_store_with_cap_capslock_full
+#define helper_check_cap_load helper_check_cap_load_capslock_full
+#define helper_move_cap helper_move_cap_capslock_full
+#define helper_set_cap_mem_map helper_set_cap_mem_map_capslock_full
+#define helper_remove_cap_mem_map helper_remove_cap_mem_map_capslock_full
+#define helper_set_pc_cap helper_set_pc_cap_capslock_full
+#define helper_csdebuggencap helper_csdebuggencap_capslock_full
+#define helper_csdebugoncapmem helper_csdebugoncapmem_capslock_full
+#define helper_csdebugclearcmmap helper_csdebugclearcmmap_capslock_full
+#define helper_csdebugprint helper_csdebugprint_capslock_full
+#define helper_capslock_debugger helper_capslock_debugger_capslock_full
+#define helper_csdebugcount helper_csdebugcount_capslock_full
+#define helper_csdebugcountprint helper_csdebugcountprint_capslock_full
+#define helper_reg_overwrite helper_reg_overwrite_capslock_full
+
 static void cap_generate(capregval_t *v, uint64_t base, uint64_t end) {
     capfat_t *cap = &v->val.cap;
