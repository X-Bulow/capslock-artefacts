+
+static inline void capslock_noop_set_scalar(CPURISCVState *env,
+                                             uint32_t rd,
+                                             uint64_t value)
+{
+    if (rd != 0) {
+        env->gpr[rd].val.scalar = value;
+        env->gpr[rd].tag = false;
+    }
+}
+
+static inline void capslock_noop_copy_reg(CPURISCVState *env,
+                                           uint32_t rd,
+                                           uint32_t rs)
+{
+    capslock_noop_set_scalar(env, rd, env->gpr[rs].val.scalar);
+}
+
+void helper_csscc(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                  uint32_t rs2)
+{
+    capslock_noop_copy_reg(env, rd, rs2);
+}
+
+void helper_cslcc(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                  uint32_t imm)
+{
+    uint64_t value = 0;
+
+    /* Cursor/base/end queries must preserve the ordinary pointer value. */
+    if (imm == 2 || imm == 3 || imm == 4) {
+        value = env->gpr[rs1].val.scalar;
+    }
+    capslock_noop_set_scalar(env, rd, value);
+}
+
+void helper_csrevoke(CPURISCVState *env, uint32_t rs1) {}
+
+void helper_csborrow(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                     uint32_t rs2)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_csborrowmut(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                        uint32_t rs2)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_csmarkunsafecell(CPURISCVState *env, uint32_t rs1,
+                             uint32_t rs2) {}
+
+void helper_csshrink(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                     uint32_t rs2)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_csshrinkto(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                       uint64_t size)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_cssplit(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                    uint32_t rs2)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_cstighten(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                      uint32_t perms)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_csseal(CPURISCVState *env, uint32_t rd, uint32_t rs1)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_csdrop(CPURISCVState *env, uint32_t rs1) {}
+
+void helper_csccsrrw(CPURISCVState *env, uint32_t rd, uint32_t rs1,
+                     uint64_t ccsr_id)
+{
+    capslock_noop_copy_reg(env, rd, rs1);
+}
+
+void helper_csloadsp(CPURISCVState *env, uint32_t rd, uint32_t rs)
+{
+    capslock_noop_copy_reg(env, rd, rs);
+}
+
+void helper_csgencapstack(CPURISCVState *env, uint32_t rs, uint64_t size) {}
+
+void helper_cap_scrub(CPURISCVState *env, uint64_t addr) {}
+
+void helper_load_with_cap(CPURISCVState *env, uint64_t addr, uint32_t rs1,
+                          uint32_t memop) {}
+
+void helper_store_with_cap(CPURISCVState *env, uint64_t addr, uint32_t rs1,
+                           uint32_t rs2, uint32_t memop, uint32_t use_cap)
+{
+    env->data_to_store_with_cap = env->gpr[rs2].val.scalar;
+}
+
+void helper_check_cap_load(CPURISCVState *env, uint64_t addr, uint32_t rd,
+                           uint32_t memop)
+{
+    env->gpr[rd].tag = false;
+}
+
+void helper_move_cap(CPURISCVState *env, uint64_t value, uint32_t rd,
+                     uint32_t rs1, uint32_t rs2)
+{
+    capslock_noop_set_scalar(env, rd, value);
+}
+
+void helper_set_cap_mem_map(CPURISCVState *env, uint32_t reg, uint64_t addr,
+                            uint64_t to_set) {}
+
+void helper_remove_cap_mem_map(CPURISCVState *env, uint64_t addr,
+                               uint32_t memop) {}
+
+void helper_set_pc_cap(CPURISCVState *env, uint32_t reg) {}
+
+void helper_csdebuggencap(CPURISCVState *env, uint32_t rd, uint64_t base,
+                          uint64_t end)
+{
+    capslock_noop_set_scalar(env, rd, base);
+}
+
+void helper_csdebugoncapmem(CPURISCVState *env, uint64_t enabled) {}
+void helper_csdebugclearcmmap(CPURISCVState *env) {}
+void helper_csdebugprint(CPURISCVState *env, uint32_t rs1) {}
+void helper_capslock_debugger(CPURISCVState *env, uint64_t value) {}
+void helper_csdebugcount(CPURISCVState *env, uint64_t index,
+                         uint64_t increment) {}
+void helper_csdebugcountprint(CPURISCVState *env) {}
+
+void helper_reg_overwrite(CPURISCVState *env, uint32_t reg_num)
+{
+    env->gpr[reg_num].tag = false;
+}

