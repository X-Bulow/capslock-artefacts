 /* CapsLock helpers */
 
+/*
+ * A3 no-op variant: retain the CapsLock-aware translator and helper-call
+ * overhead, but replace capability semantics with scalar pass-throughs.
+ * The original implementations are kept under private names so this patch
+ * remains a small, auditable delta from the artefact QEMU.
+ */
+#define helper_csscc helper_csscc_capslock_full
+#define helper_cslcc helper_cslcc_capslock_full
+#define helper_csrevoke helper_csrevoke_capslock_full
